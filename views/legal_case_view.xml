<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_legal_case_tree" model="ir.ui.view">
        <field name="name">legal.case.list</field>
        <field name="model">legal.case</field>
        <field name="arch" type="xml">
            <list string="Legal Cases" decoration-info="state == 'draft'" decoration-warning="state == 'pending'" decoration-success="state == 'won'" decoration-danger="state == 'lost'">
                <field name="name"/>
                <field name="title"/>
                <field name="client_id"/>
                <field name="opponent_id"/>
                <field name="lawyer_id" widget="many2one_avatar_user"/>
                <field name="court_name"/>
                <field name="case_number"/>
                <field name="claim_amount"/>
                <field name="state" widget="badge" decoration-info="state == 'draft'" decoration-success="state in ('won','settled')" decoration-danger="state == 'lost'"/>
            </list>
        </field>
    </record>

    <record id="view_legal_case_kanban" model="ir.ui.view">
        <field name="name">legal.case.kanban</field>
        <field name="model">legal.case</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" sample="1">
                <field name="name"/>
                <field name="title"/>
                <field name="client_id"/>
                <field name="lawyer_id"/>
                <field name="case_number"/>
                <field name="claim_amount"/>
                <field name="currency_id"/>
                <field name="state"/>
                <templates>
                    <t t-name="card">
                        <div class="o_legal_case_card p-3">
                            <div class="d-flex justify-content-between align-items-start gap-2 mb-2">
                                <strong class="text-truncate"><field name="title"/></strong>
                                <field name="state" widget="badge"
                                       decoration-info="state == 'draft'"
                                       decoration-warning="state in ('in_progress', 'pending')"
                                       decoration-success="state in ('won', 'settled', 'closed')"
                                       decoration-danger="state == 'lost'"/>
                            </div>
                            <div class="text-muted mb-1"><field name="name"/> · <field name="case_number"/></div>
                            <div class="mb-2"><i class="fa fa-user me-1"/> <field name="client_id"/></div>
                            <div class="d-flex justify-content-between align-items-center border-top pt-2">
                                <span class="text-muted"><i class="fa fa-briefcase me-1"/> <field name="lawyer_id"/></span>
                                <strong><field name="claim_amount"/></strong>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_legal_case_form" model="ir.ui.view">
        <field name="name">legal.case.form</field>
        <field name="model">legal.case</field>
        <field name="arch" type="xml">
            <form string="Legal Case">
                <header>
                    <button name="action_start" string="Start Case" type="object" class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_pending" string="Pending Court" type="object" invisible="state != 'in_progress'"/>
                    <button name="action_close" string="Close Case" type="object" class="oe_highlight" invisible="state not in ('in_progress', 'pending')"/>
                    <button name="action_set_to_draft" string="Reset to Draft" type="object" invisible="state not in ('closed', 'won', 'lost', 'settled')"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,in_progress,pending,closed"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_hearings" type="object" class="oe_stat_button" icon="fa-gavel">
                            <field name="hearing_count" widget="statinfo" string="Hearings"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                        <h2>
                            <field name="title" placeholder="e.g. Compensation Claim Against XYZ Company..."/>
                        </h2>
                    </div>
                    <group>
                        <group string="Case &amp; Court Details">
                            <field name="case_number"/>
                            <field name="court_name"/>
                            <field name="lawyer_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group string="Parties Involved">
                            <field name="client_id"/>
                            <field name="opponent_id"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="claim_amount"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Hearings" name="hearings">
                            <field name="hearing_ids" readonly="1">
                                <list>
                                    <field name="name"/>
                                    <field name="date"/>
                                    <field name="lawyer_id"/>
                                    <field name="state" widget="badge"/>
                                    <field name="summary"/>
                                </list>
                            </field>
                        </page>
                        <page string="Contracts" name="contracts">
                            <field name="contract_ids" readonly="1">
                                <list>
                                    <field name="name"/>
                                    <field name="title"/>
                                    <field name="contract_type"/>
                                    <field name="state" widget="badge"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_legal_case_search" model="ir.ui.view">
        <field name="name">legal.case.search</field>
        <field name="model">legal.case</field>
        <field name="arch" type="xml">
            <search string="Search Cases">
                <field name="name"/>
                <field name="title"/>
                <field name="case_number"/>
                <field name="client_id"/>
                <field name="lawyer_id"/>
                <field name="opponent_id"/>
                <field name="court_name"/>
                <filter string="My Cases" name="my_cases" domain="[('lawyer_id', '=', uid)]"/>
                <filter string="In Progress" name="in_progress" domain="[('state', '=', 'in_progress')]"/>
                <filter string="Pending Court" name="pending" domain="[('state', '=', 'pending')]"/>
                <filter string="Closed" name="closed" domain="[('state', 'in', ('won', 'lost', 'settled', 'closed'))]"/>
                <separator/>
                <group expand="0" string="Group By">
                    <filter string="Lawyer" name="groupby_lawyer" context="{'group_by': 'lawyer_id'}"/>
                    <filter string="Status" name="groupby_state" context="{'group_by': 'state'}"/>
                    <filter string="Client" name="groupby_client" context="{'group_by': 'client_id'}"/>
                    <filter string="Court" name="groupby_court" context="{'group_by': 'court_name'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_legal_case" model="ir.actions.act_window">
        <field name="name">Legal Cases</field>
        <field name="res_model">legal.case</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="search_view_id" ref="view_legal_case_search"/>
        <field name="context">{'search_default_my_cases': 1}</field>
    </record>

</odoo>