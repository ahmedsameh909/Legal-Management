<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_partner_form_legal_inherit" model="ir.ui.view">
        <field name="name">res.partner.form.legal.inherit</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_partner_cases" type="object" class="oe_stat_button" icon="fa-gavel" invisible="case_count == 0">
                    <field name="case_count" widget="statinfo" string="Cases"/>
                </button>
                <button name="action_view_partner_contracts" type="object" class="oe_stat_button" icon="fa-file-text-o" invisible="contract_count == 0">
                    <field name="contract_count" widget="statinfo" string="Contracts"/>
                </button>
            </xpath>
            <xpath expr="//field[@name='vat']" position="after">
                <field name="national_id" placeholder="National ID / Commercial Reg..."/>
                <field name="is_legal_client"/>
                <field name="is_opponent"/>
            </xpath>
        </field>
    </record>

    <record id="view_res_partner_filter_legal_inherit" model="ir.ui.view">
        <field name="name">res.partner.select.legal.inherit</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_res_partner_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <filter string="Legal Clients" name="legal_clients" domain="[('is_legal_client', '=', True)]"/>
                <filter string="Opponents" name="opponents" domain="[('is_opponent', '=', True)]"/>
            </xpath>
        </field>
    </record>

    <record id="action_legal_client_partner" model="ir.actions.act_window">
        <field name="name">Clients</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="context">{'search_default_legal_clients': 1, 'default_is_legal_client': 1}</field>
    </record>

</odoo>