<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="cron_check_contract_expiration" model="ir.cron">
            <field name="name">Legal Management: Check Expired Contracts</field>
            <field name="model_id" ref="model_legal_contract"/>
            <field name="state">code</field>
            <field name="code">
contracts = env['legal.contract'].search([('state', '=', 'active'), ('end_date', '&lt;', datetime.date.today())])
contracts.action_expire()
            </field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>

    </data>
</odoo>