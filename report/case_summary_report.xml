<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="action_report_case_summary" model="ir.actions.report">
        <field name="name">Case Summary Report</field>
        <field name="model">legal.case</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">legal_managment.report_case_summary_template</field>
        <field name="report_file">legal_managment.report_case_summary_template</field>
        <field name="print_report_name">'Case Summary - %s' % (object.name)</field>
        <field name="binding_model_id" ref="model_legal_case"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_case_summary_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2 class="text-center">Legal Case Summary</h2>
                        <hr/>
                        <table class="table table-bordered mt32">
                            <tr>
                                <td><strong>Case Reference:</strong></td>
                                <td><span t-field="doc.name"/></td>
                                <td><strong>Status:</strong></td>
                                <td><span t-field="doc.state"/></td>
                            </tr>
                            <tr>
                                <td><strong>Case Title:</strong></td>
                                <td colspan="3"><span t-field="doc.title"/></td>
                            </tr>
                            <tr>
                                <td><strong>Client:</strong></td>
                                <td><span t-field="doc.client_id.name"/></td>
                                <td><strong>Opponent:</strong></td>
                                <td><span t-field="doc.opponent_id.name"/></td>
                            </tr>
                            <tr>
                                <td><strong>Assigned Lawyer:</strong></td>
                                <td><span t-field="doc.lawyer_id.name"/></td>
                                <td><strong>Claim Amount:</strong></td>
                                <td><span t-field="doc.claim_amount" t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/></td>
                            </tr>
                        </table>

                        <h4 class="mt16">Hearings History</h4>
                        <table class="table table-sm">
                            <thead>
                                <tr>
                                    <th>Ref</th>
                                    <th>Date</th>
                                    <th>Court</th>
                                    <th>Status</th>
                                    <th>Summary</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="doc.hearing_ids" t-as="hearing">
                                    <tr>
                                        <td><span t-field="hearing.name"/></td>
                                        <td><span t-field="hearing.date"/></td>
                                        <td><span t-field="hearing.court_name"/></td>
                                        <td><span t-field="hearing.state"/></td>
                                        <td><span t-field="hearing.summary"/></td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                    </div>
                </t>
            </t>
        </t>
    </template>

</odoo>