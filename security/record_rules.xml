<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- قواعد القضايا -->
        <record id="legal_case_user_rule" model="ir.rule">
            <field name="name">Lawyer: See Own Cases Only</field>
            <field name="model_id" ref="model_legal_case"/>
            <field name="domain_force">[('lawyer_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_legal_user'))]"/>
        </record>

        <record id="legal_case_manager_rule" model="ir.rule">
            <field name="name">Manager: See All Cases</field>
            <field name="model_id" ref="model_legal_case"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_legal_manager'))]"/>
        </record>

        <!-- قواعد الجلسات -->
        <record id="legal_hearing_user_rule" model="ir.rule">
            <field name="name">Lawyer: See Own Hearings Only</field>
            <field name="model_id" ref="model_legal_hearing"/>
            <field name="domain_force">['|', ('lawyer_id', '=', user.id), ('case_id.lawyer_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_legal_user'))]"/>
        </record>

        <record id="legal_hearing_manager_rule" model="ir.rule">
            <field name="name">Manager: See All Hearings</field>
            <field name="model_id" ref="model_legal_hearing"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_legal_manager'))]"/>
        </record>

        <!-- قواعد العقود -->
        <record id="legal_contract_user_rule" model="ir.rule">
            <field name="name">Lawyer: See Own Contracts Only</field>
            <field name="model_id" ref="model_legal_contract"/>
            <field name="domain_force">[('responsible_user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_legal_user'))]"/>
        </record>

        <record id="legal_contract_manager_rule" model="ir.rule">
            <field name="name">Manager: See All Contracts</field>
            <field name="model_id" ref="model_legal_contract"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_legal_manager'))]"/>
        </record>

    </data>
</odoo>