<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="module_category_legal_management" model="ir.module.category">
            <field name="name">Legal Management</field>
            <field name="description">Helps manage legal cases, hearings, and contracts.</field>
            <field name="sequence">10</field>
        </record>

        <record id="group_legal_user" model="res.groups">
            <field name="name">User / Lawyer</field>
            <field name="category_id" ref="module_category_legal_management"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="group_legal_manager" model="res.groups">
            <field name="name">Manager</field>
            <field name="category_id" ref="module_category_legal_management"/>
            <field name="implied_ids" eval="[(4, ref('group_legal_user'))]"/>
            <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        </record>

    </data>
</odoo>